# Copy to .env.local. Configure one or more AI providers; they are tried in this order.

# 1. Azure OpenAI (Microsoft for Startups credits)
#    Azure AI Foundry -> your resource -> Keys and Endpoint; Deployments -> deployment name
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# 2. Anthropic Claude (paid API credits)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# 3. Google Gemini (free tier): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Written by `npx convex dev`; needed for classroom broadcast mode only
NEXT_PUBLIC_CONVEX_URL=
